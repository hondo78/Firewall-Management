# Kopieren nach .env und Werte erzeugen (chmod 600 .env)
POSTGRES_PASSWORD=            # openssl rand -hex 24
# NIE ändern oder verlieren – verschlüsselt alle gespeicherten API-Zugangsdaten
FWM_MASTER_KEY=               # openssl rand -base64 32
JWT_SECRET=                   # openssl rand -hex 32 (leer = Logins verfallen bei jedem Neustart)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=               # nur für den ersten Start (solange keine Benutzer existieren)
FWM_PORT=8096
TZ=Europe/Berlin

# Audit-Export per Syslog (leer = aus), z. B. Warroom
SYSLOG_HOST=
SYSLOG_PORT=514
SYSLOG_PROTOCOL=udp

# Sophos-Attrappe mitstarten (für Demo/Tests). Für den Produktivbetrieb leeren.
COMPOSE_PROFILES=mock
